@RestResource(urlMapping='/students/*')
global class MyRestResource {

    @HttpDelete
    global static String doDelete() {
        return 'DELETE method called from API';
    }

    @HttpGet
    global static Student__c doGet() {
        RestRequest req = RestContext.request;
        System.debug(req);
        String stId = req.requestURI;
        System.debug(stId);
        System.debug(stId.lastIndexOf('/'));
        System.debug(stId.lastIndexOf('/')+1);
        System.debug(stId.substring(stId.lastIndexOf('/')+1));
        String studentId = stId.substring(stId.lastIndexOf('/')+1);
        Student__c student = [select Id,Name,DOB__c From Student__c where Id=:studentId];
        return student;
    }

    @HttpPost
    global static String doPost() {
        return 'POST method called from API';
    }
}


